# Assembly prelude for asm-processor (INCLUDE_ASM / GLOBAL_ASM blocks in C files).
# Based on asm-processor's prelude.inc (Unlicense). Unlike that one, jlabel is
# global: the jump tables live in a separate rodata object and refer to the
# case labels by name.

.set noat
.set noreorder
.set gp=64

# A function symbol.
.macro glabel label, visibility=global
    .\visibility \label
    .type \label, @function
    \label:
.endm

# The end of a function symbol.
.macro endlabel label
    .size \label, . - \label
.endm

# An alternative entry to a function.
.macro alabel label, visibility=global
    .\visibility \label
    .type \label, @function
    \label:
.endm

# A data symbol.
.macro dlabel label, visibility=global
    .\visibility \label
    \label:
.endm

# End of a data symbol.
.macro enddlabel label
    .size \label, . - \label
.endm

# A label referenced by a jump table.
.macro jlabel label, visibility=global
    .\visibility \label
    \label:
.endm

# A label referenced by an error handler table.
.macro ehlabel label, visibility=global
    .\visibility \label
    \label:
.endm

# Marks a function that has not been matched yet.
.macro nonmatching label, size=1
    .global \label\().NON_MATCHING
    .type \label\().NON_MATCHING, @object
    .size \label\().NON_MATCHING, \size
    \label\().NON_MATCHING:
.endm

